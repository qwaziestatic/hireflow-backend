# ─── SERVER ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE (NeonDB PostgreSQL) ─────────────────────────
# Get this from your NeonDB dashboard → Connection String
DATABASE_URL=postgresql://neondb_owner:npg_i9oKCI7xQbfD@ep-quiet-paper-altrmget.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─── JWT ──────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── GOOGLE OAUTH2 ────────────────────────────────────────
# Create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── SESSION (for Passport OAuth flow) ───────────────────
SESSION_SECRET=your_session_secret_here

# ─── FRONTEND URL (for CORS + OAuth redirect) ─────────────
FRONTEND_URL=http://localhost:5173
